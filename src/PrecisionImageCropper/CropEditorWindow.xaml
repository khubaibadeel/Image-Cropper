<Window x:Class="PrecisionImageCropper.CropEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrecisionImageCropper.Controls"
        Title="Crop Image" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DAE2"/>
            <Setter Property="Foreground" Value="#263445"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1769D8"/>
            <Setter Property="BorderBrush" Value="#1769D8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#53657A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#CAD3DF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ImageNameText" FontSize="18" FontWeight="SemiBold" Foreground="#263445" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ImageInfoText" Margin="0,3,0,0" Foreground="#66758A" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#66758A"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,1,0,0" Padding="20,13">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="PreviousButton" Style="{StaticResource ActionButton}" Click="Previous_Click">Previous</Button>
                    <Button x:Name="NextButton" Style="{StaticResource ActionButton}" Click="Next_Click">Next</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Click="Cancel_Click">Cancel</Button>
                    <Button Style="{StaticResource ActionButton}" Click="Apply_Click">Apply</Button>
                    <Button x:Name="ApplyNextButton" Style="{StaticResource PrimaryActionButton}" Click="ApplyNext_Click">Apply &amp; Next</Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E9EDF2" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <ScrollViewer x:Name="PreviewViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="PreviewViewport_SizeChanged">
                        <Grid x:Name="PreviewCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                            <controls:CropAdorner x:Name="CropOverlay" CropChanged="CropOverlay_CropChanged"/>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewLoadingText" Text="Loading preview..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66758A"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Margin="18,0,0,0" Padding="16" Background="White" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Crop Rectangle" FontSize="16" FontWeight="SemiBold" Foreground="#263445" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Width"/><TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" Tag="Width" LostFocus="NumericField_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="Height"/><TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" Tag="Height" LostFocus="NumericField_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Aspect Ratio"/>
                        <ComboBox x:Name="AspectRatioBox" Margin="0,0,0,8" Padding="6,4" SelectionChanged="AspectRatioBox_SelectionChanged">
                            <ComboBoxItem Content="FreeForm"/><ComboBoxItem Content="Original"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="3:2"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="5:4"/><ComboBoxItem Content="4:5"/><ComboBoxItem Content="A4 Portrait"/><ComboBoxItem Content="A4 Landscape"/><ComboBoxItem Content="Custom"/>
                        </ComboBox>
                        <Grid x:Name="CustomRatioPanel" Margin="0,0,0,12" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource FieldLabel}" Text="Custom width"/><TextBox x:Name="CustomWidthBox" Style="{StaticResource FieldBox}" Text="1" LostFocus="CustomRatio_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="Custom height"/><TextBox x:Name="CustomHeightBox" Style="{StaticResource FieldBox}" Text="1" LostFocus="CustomRatio_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource FieldLabel}" Text="X"/><TextBox x:Name="XBox" Style="{StaticResource FieldBox}" Tag="X" LostFocus="NumericField_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="Y"/><TextBox x:Name="YBox" Style="{StaticResource FieldBox}" Tag="Y" LostFocus="NumericField_LostFocus" KeyDown="NumericField_KeyDown"/></StackPanel>
                        </Grid>
                        <Separator Margin="0,0,0,14"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Zoom"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="2" Value="1" Width="180" ValueChanged="ZoomSlider_ValueChanged"/>
                            <TextBlock x:Name="ZoomText" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#53657A"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Click="Reset_Click">Reset</Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
