<Window x:Class="PrecisionImageCropper.RotateFlipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotate and Flip Image" Width="1040" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DAE2"/><Setter Property="Foreground" Value="#263445"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1769D8"/><Setter Property="BorderBrush" Value="#1769D8"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="TransformButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#D2DCE7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel><TextBlock x:Name="ImageNameText" FontSize="18" FontWeight="SemiBold" Foreground="#263445" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ImageInfoText" Margin="0,3,0,0" Foreground="#66758A" FontSize="12"/></StackPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#66758A"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,1,0,0" Padding="20,13">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="PreviousButton" Style="{StaticResource ActionButton}" Click="Previous_Click">Previous</Button><Button x:Name="NextButton" Style="{StaticResource ActionButton}" Click="Next_Click">Next</Button></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource ActionButton}" Click="Cancel_Click">Cancel</Button><Button Style="{StaticResource ActionButton}" Click="Apply_Click">Apply</Button><Button x:Name="ApplyNextButton" Style="{StaticResource PrimaryActionButton}" Click="ApplyNext_Click">Apply &amp; Next</Button></StackPanel>
            </DockPanel>
        </Border>
        <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E9EDF2" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="6"><Grid><Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True" Margin="18"/><TextBlock x:Name="PreviewLoadingText" Text="Loading preview..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66758A"/></Grid></Border>
            <Border Grid.Column="1" Margin="18,0,0,0" Padding="16" Background="White" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="6"><StackPanel>
                <TextBlock Text="Rotate Image" FontSize="16" FontWeight="SemiBold" Foreground="#263445" Margin="0,0,0,12"/>
                <Button Style="{StaticResource TransformButton}" Click="Clockwise_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="22" Width="34" VerticalAlignment="Center"/><TextBlock Text="Clockwise 90°" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource TransformButton}" Click="CounterClockwise_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↺" FontSize="22" Width="34" VerticalAlignment="Center"/><TextBlock Text="Counter-Clockwise 90°" VerticalAlignment="Center"/></StackPanel></Button>
                <Separator Margin="0,14,0,14"/>
                <TextBlock Text="Flip Image" FontSize="16" FontWeight="SemiBold" Foreground="#263445" Margin="0,0,0,12"/>
                <Button x:Name="HorizontalFlipButton" Style="{StaticResource TransformButton}" Click="HorizontalFlip_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↔" FontSize="22" Width="34" VerticalAlignment="Center"/><TextBlock Text="Horizontally" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="VerticalFlipButton" Style="{StaticResource TransformButton}" Click="VerticalFlip_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↕" FontSize="22" Width="34" VerticalAlignment="Center"/><TextBlock Text="Vertically" VerticalAlignment="Center"/></StackPanel></Button>
                <TextBlock x:Name="StateText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#66758A" FontSize="12"/>
            </StackPanel></Border>
        </Grid>
    </DockPanel>
</Window>
