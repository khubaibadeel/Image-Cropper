<Window x:Class="PrecisionImageCropper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PrecisionImageCropper.Controls" Title="Precision Image Cropper" Width="1280" Height="820" MinWidth="900" MinHeight="600" Background="#F4F5F7" AllowDrop="True" PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#4C5159" Geometry="M 0,0 L 16,0 16,16 0,16 Z"/><GeometryDrawing Brush="#3D424A" Geometry="M 0,0 L 8,0 8,8 0,8 Z"/><GeometryDrawing Brush="#3D424A" Geometry="M 8,8 L 16,8 16,16 8,16 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D8DCE2" BorderThickness="0,0,0,1" Padding="8"><StackPanel Orientation="Horizontal">
      <Button Click="Open_Click">Open Image</Button><Button Click="Reset_Click">Reset</Button><Separator Width="12"/><Button Click="Fit_Click">Fit to Window</Button><Button Click="Actual_Click">100%</Button>
      <ComboBox x:Name="ZoomCombo" Width="80" Margin="6,3" SelectionChanged="ZoomCombo_SelectionChanged"><ComboBoxItem Content="25%"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="75%"/><ComboBoxItem Content="100%" IsSelected="True"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/></ComboBox>
      <Button x:Name="CropSaveButton" Click="CropSave_Click" Background="#1665D8" Foreground="White">Crop &amp; Save</Button>
    </StackPanel></Border>
    <StatusBar DockPanel.Dock="Bottom" Background="White"><StatusBarItem><TextBlock Text="{Binding ImageSizeText}"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="Crop: "/><TextBlock Text="{Binding CropSizeText}"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="Zoom: "/><TextBlock Text="{Binding ZoomText}"/></StatusBarItem></StatusBar>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#252A31" Padding="12"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageScroll_PreviewMouseWheel" SizeChanged="ImageScroll_SizeChanged">
        <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Checker}"><Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/><local:CropAdorner x:Name="CropLayer"/></Grid>
      </ScrollViewer></Border>
      <Border Grid.Column="1" Background="White" BorderBrush="#D8DCE2" BorderThickness="1,0,0,0" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="CROP RECTANGLE" FontWeight="SemiBold" Foreground="#4B5563"/><TextBlock Text="Width (pixels)" Margin="0,12,0,0"/><TextBox x:Name="WidthBox" TextChanged="Geometry_TextChanged"/><TextBlock Text="Height (pixels)"/><TextBox x:Name="HeightBox" TextChanged="Geometry_TextChanged"/>
        <TextBlock Text="Aspect Ratio"/><ComboBox x:Name="AspectCombo" SelectionChanged="AspectCombo_SelectionChanged" Margin="0,2,0,12"><ComboBoxItem Content="FreeForm" IsSelected="True"/><ComboBoxItem Content="Original"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="3:2"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="5:4"/><ComboBoxItem Content="4:5"/><ComboBoxItem Content="A4 Portrait"/><ComboBoxItem Content="A4 Landscape"/><ComboBoxItem Content="Custom"/></ComboBox>
        <Separator/><TextBlock Text="CROP POSITION" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,14,0,0"/><TextBlock Text="X (pixels)" Margin="0,12,0,0"/><TextBox x:Name="XBox" TextChanged="Geometry_TextChanged"/><TextBlock Text="Y (pixels)"/><TextBox x:Name="YBox" TextChanged="Geometry_TextChanged"/>
        <Separator/><TextBlock Text="SIZE / UNITS" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,14,0,0"/><ComboBox x:Name="UnitsCombo" SelectionChanged="UnitsCombo_SelectionChanged" Margin="0,8,0,4"><ComboBoxItem Content="Pixels" IsSelected="True"/><ComboBoxItem Content="Inches"/><ComboBoxItem Content="Centimeters"/><ComboBoxItem Content="Millimeters"/></ComboBox><TextBlock Text="DPI"/><TextBox x:Name="DpiBox" Text="300" TextChanged="Unit_TextChanged"/><TextBlock Text="Width / Height in selected units"/><DockPanel><TextBox x:Name="UnitWidthBox" Width="112" TextChanged="Unit_TextChanged"/><TextBox x:Name="UnitHeightBox" Width="112" Margin="8,2,0,6" TextChanged="Unit_TextChanged"/></DockPanel><TextBlock x:Name="CalculatedPixels" Foreground="#596579" FontSize="11"/>
        <Separator/><TextBlock Text="IMAGE INFORMATION" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,14,0,0"/><TextBlock x:Name="InfoText" Margin="0,10,0,12" TextWrapping="Wrap"/><Button Click="Reset_Click">Reset Selection</Button><Button Click="CropSave_Click" Background="#1665D8" Foreground="White">Crop &amp; Save</Button>
        <ProgressBar x:Name="BusyIndicator" Visibility="Collapsed" IsIndeterminate="True" Height="4" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
  </DockPanel>
</Window>
