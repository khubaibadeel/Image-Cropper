<Window x:Class="PrecisionImageCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precision Image Cropper"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="#F5F6F8" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="13,7"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DAE2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#263445"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#1769D8"/><Setter Property="BorderBrush" Value="#1769D8"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Foreground" Value="#405166"/><Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="#D9E0E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryToolbarButton}" Click="Open_Click" ToolTip="Open one or more image files">Open Images &#x25BE;</Button>
                    <Menu Background="Transparent" Margin="0,0,8,0" VerticalAlignment="Center">
                        <MenuItem x:Name="OpenRecentMenu" Header="Open Recent" Padding="13,7" Foreground="#263445" Background="White" BorderBrush="#D5DAE2" ToolTip="Open a recently used image or folder">
                            <MenuItem x:Name="RecentFilesMenu" Header="Recent Files"/>
                            <Separator/>
                            <MenuItem x:Name="RecentFoldersMenu" Header="Recent Folders"/>
                        </MenuItem>
                    </Menu>
                    <Button Style="{StaticResource ToolbarButton}" Click="PasteImage_Click" ToolTip="Paste image from clipboard (Ctrl+V)">Paste Image</Button>
                    <Button x:Name="SaveAllButton" Style="{StaticResource ToolbarButton}" Click="SaveAll_Click" ToolTip="Save all queued images to a ZIP archive">Save All</Button>
                    <Button x:Name="CancelExportButton" Style="{StaticResource ToolbarButton}" Click="CancelExport_Click" Visibility="Collapsed" ToolTip="Cancel ZIP export">Cancel Export</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ExportProgressText" Margin="0,0,14,0" Foreground="#1769D8"/><TextBlock Foreground="#66758A" Text="{Binding QueueSummary}" /></StackPanel>
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock Foreground="#66758A" Text="Cards retain lightweight previews; original pixels are loaded only for output." /></StatusBarItem>
        </StatusBar>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26">
                <ListBox ItemsSource="{Binding BatchItems}" SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260" Margin="0,0,18,18" Padding="12" Background="White" BorderBrush="#D9E0E8" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="CropItem_Click" ToolTip="Crop Image">&#x25A3;</Button>
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="RotateFlipItem_Click" ToolTip="Rotate and Flip Image">&#x21BB;</Button>
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="CopyItem_Click" ToolTip="Copy Edited Image">&#x29C9;</Button>
                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="RemoveItem_Click" ToolTip="Remove Image">&#x2715;</Button>
                                        </StackPanel>
                                        <Border Background="#E9F2FF" CornerRadius="9" Padding="7,3" HorizontalAlignment="Left"><TextBlock Foreground="#1769D8" FontSize="11" FontWeight="SemiBold" Text="{Binding EditStateText}" /></Border>
                                    </DockPanel>
                                    <Border Grid.Row="1" Background="#F1F3F6" CornerRadius="4">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                            <TextBlock Text="Loading preview…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#77869A">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                                        <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" Foreground="#263445" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalFileName}"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding OriginalDimensionsText}" Foreground="#66758A" FontSize="12"/>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding OutputDimensionsText, StringFormat=Output: {0}}" Foreground="#66758A" FontSize="12"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding StatusMessage}" Foreground="#1769D8" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>
                                        <Button Tag="{Binding}" Click="SaveItem_Click" ToolTip="Save Image" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="11,5" Background="#1769D8" Foreground="White" BorderBrush="#1769D8" Cursor="Hand">Save</Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <Border Background="Transparent" IsHitTestVisible="False">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                    <TextBlock Text="Drop images here" FontSize="25" FontWeight="SemiBold" Foreground="#34465A" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,9,0,0" Text="Open images or paste from the clipboard. You can select multiple files at once." Foreground="#718096" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
