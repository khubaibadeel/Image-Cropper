<Window x:Class="PrecisionImageCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precision Image Cropper" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
    <DockPanel Margin="10,0,10,0">
        <Border DockPanel.Dock="Top" Height="60" Background="White" Margin="-10,0,-10,10" Padding="18,7,18,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Grid Width="39" Height="39" Margin="0,2,12,0"><Path Data="{StaticResource IconCrop}" Stroke="{StaticResource TextBrush}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid><StackPanel><TextBlock Text="Precision Image Cropper" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Simple. Precise. Professional." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0">
                    <Button Style="{StaticResource PrimaryToolbarButton}" Click="Open_Click" ToolTip="Open images&#x0a;Ctrl + O"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Stroke="White" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Open" VerticalAlignment="Center"/></StackPanel></Button>
                    <Menu Background="Transparent" Margin="8,0,3,0" VerticalAlignment="Center"><MenuItem x:Name="OpenRecentMenu" Background="Transparent" BorderThickness="0" Padding="0"><MenuItem.Header><StackPanel Width="48"><Path Data="{StaticResource IconClock}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Recent" FontSize="11" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></MenuItem.Header><MenuItem x:Name="RecentFilesMenu" Header="Recent files"/><Separator/><MenuItem x:Name="RecentFoldersMenu" Header="Recent folders"/></MenuItem></Menu>
                    <Button Style="{StaticResource SecondaryToolbarCommand}" Margin="3,0" Click="PasteImage_Click" ToolTip="Paste image&#x0a;Ctrl + V"><StackPanel><Path Data="{StaticResource IconPaste}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Paste" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Border Width="1" Height="32" Background="#D8E0EA" Margin="8,0"/>
                    <Button x:Name="UndoButton" Style="{StaticResource SecondaryToolbarCommand}" Click="Undo_Click" ToolTip="Undo&#x0a;Ctrl + Z"><StackPanel><Path Data="{StaticResource IconUndo}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Undo" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="RedoButton" Style="{StaticResource SecondaryToolbarCommand}" Click="Redo_Click" ToolTip="Redo&#x0a;Ctrl + Y"><StackPanel><Path Data="{StaticResource IconRedo}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Redo" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                    <Border Width="1" Height="32" Background="#D8E0EA" Margin="8,0"/>
                    <Button x:Name="ResetButton" Style="{StaticResource SecondaryToolbarCommand}" Click="Reset_Click" ToolTip="Reset selected image"><StackPanel><Path Data="{StaticResource IconReset}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Reset" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ExportProgressText" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><Button x:Name="SaveAllButton" Style="{StaticResource PrimaryToolbarButton}" Click="SaveAll_Click" ToolTip="Export all images as ZIP"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconExport}" Stroke="White" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Export" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="CancelExportButton" Style="{StaticResource SecondaryButton}" Click="CancelExport_Click" Visibility="Collapsed">Cancel</Button></StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="42" Background="White" Margin="-10,10,-10,0" Padding="18,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{StaticResource IconImage}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="Ready" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Border Width="1" Height="18" Background="#D9E1EB" Margin="2,0,12,0"/><TextBlock x:Name="StatusBarText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
            <StackPanel x:Name="ZoomControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Zoom out"><Path Data="M5,11 L17,11" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"/></Button><TextBlock Text="100%" Width="45" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextBrush}"/><Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Zoom in"><Path Data="{StaticResource IconPlus}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"/></Button><Border Width="1" Height="18" Background="#D9E1EB" Margin="12,0"/><Button Style="{StaticResource SecondaryButton}" Height="30" ToolTip="Fit to window">Fit</Button><Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Actual size"><Path Data="{StaticResource IconActual}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8"/></Button></StackPanel>
        </Grid></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="190"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300" MinWidth="230"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}"><DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,18,18,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><TextBlock Text="Images" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><Border DockPanel.Dock="Right" Background="#F1F4F8" CornerRadius="12" Padding="9,4"><TextBlock Text="{Binding ImageCount}" FontSize="11" Foreground="{StaticResource TextBrush}"/></Border></DockPanel></Border>
                <Border DockPanel.Dock="Bottom" Height="58" Padding="16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" ToolTip="Grid view" Visibility="Collapsed"><Path Data="{StaticResource IconGrid}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"/></Button><Button Style="{StaticResource IconButton}" ToolTip="List view" Visibility="Collapsed"><Path Data="{StaticResource IconList}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"/></Button></StackPanel><Button DockPanel.Dock="Right" x:Name="RemoveButton" Style="{StaticResource DangerIconButton}" Click="RemoveSelected_Click" ToolTip="Remove Selected Image&#x0a;Delete"><Path Data="{StaticResource IconTrash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Button></DockPanel></Border>
                <Grid><ListBox ItemsSource="{Binding BatchItems}" SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}" BorderThickness="0" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Padding="12,9" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#EDF5FF"/><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#F5F8FC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" Background="#EDF1F6" CornerRadius="5"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OriginalDimensionsText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding EditStateText}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="170"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="{StaticResource IconImage}" Stroke="#D4DBE5" StrokeThickness="1.6" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="No images yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,7"/><TextBlock Text="Open or drag images to get started" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                </Grid>
            </DockPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18"><Grid>
                <Border x:Name="DropZone" BorderBrush="#C7D4E6" BorderThickness="1" CornerRadius="12" Background="#FBFCFE"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" TextBlock.TextAlignment="Center"><Grid Width="124" Height="100" HorizontalAlignment="Center"><Path Data="{StaticResource IconImage}" Stroke="#9DAABA" StrokeThickness="1.7" Width="74" Height="74" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/><Path Data="{StaticResource IconImage}" Stroke="#7F8EA2" StrokeThickness="2" Width="78" Height="78" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"/><Ellipse Fill="{StaticResource AccentBrush}" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom"/><Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"/></Grid><TextBlock Text="Drop images here" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,26,0,10"/><TextBlock Text="Open images, paste from clipboard, or drag and drop." FontSize="14" Foreground="{StaticResource MutedBrush}"/><Button Style="{StaticResource PrimaryButton}" Width="220" Margin="0,28,0,0" HorizontalAlignment="Center" Click="Open_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolder}" Stroke="White" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Open Images"/></StackPanel></Button><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0"><Border Background="#F0F3F7" CornerRadius="5" Padding="8,4"><TextBlock Text="Ctrl + O" FontSize="11" Foreground="{StaticResource TextBrush}"/></Border><TextBlock Text=" to open" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,20,0" VerticalAlignment="Center"/><Border Width="1" Height="18" Background="#D5DEE9"/><Border Background="#F0F3F7" CornerRadius="5" Padding="8,4" Margin="20,0,0,0"><TextBlock Text="Ctrl + V" FontSize="11" Foreground="{StaticResource TextBrush}"/></Border><TextBlock Text=" to paste" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><Border Height="1" Background="#DDE4ED" Margin="44,28,44,18" Visibility="Collapsed"/><TextBlock Text="Or try a sample image" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" IsHitTestVisible="False" Visibility="Collapsed"><Border Width="62" Height="62" CornerRadius="6" Margin="5" Background="#77B7D5"><Path Data="{StaticResource IconImage}" Stroke="White" Opacity=".8" StrokeThickness="1.5" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="62" Height="62" CornerRadius="6" Margin="5" Background="#6A9E57"><Path Data="{StaticResource IconImage}" Stroke="White" Opacity=".8" StrokeThickness="1.5" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="62" Height="62" CornerRadius="6" Margin="5" Background="#7787AA"><Path Data="{StaticResource IconImage}" Stroke="White" Opacity=".8" StrokeThickness="1.5" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="62" Height="62" CornerRadius="6" Margin="5" Background="#C99B76"><Path Data="{StaticResource IconImage}" Stroke="White" Opacity=".8" StrokeThickness="1.5" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel></StackPanel></Border>
                <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Background="#293442" CornerRadius="8" Padding="18"><Image Source="{Binding SelectedBatchItem.Thumbnail}" Stretch="Uniform"/></Border></Grid>
            </Grid></Border>
            <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="20"><Grid>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="{StaticResource IconCrop}" Stroke="#9AA8BA" StrokeThickness="2" Width="94" Height="94" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,38,0,22"/><TextBlock Text="Select an image to start" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Crop, rotate, and export with precision." HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,30" FontSize="12" Foreground="{StaticResource MutedBrush}"/><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Path Data="{StaticResource IconCrop}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="33" Height="33" Stretch="Uniform"/><StackPanel Margin="13,0,0,0"><TextBlock Text="Precise Cropping" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Custom size and aspect ratios" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Path Data="{StaticResource IconRotate}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="33" Height="33" Stretch="Uniform"/><StackPanel Margin="13,0,0,0"><TextBlock Text="Rotate &amp; Flip" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Adjust orientation" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Path Data="{StaticResource IconLayers}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="33" Height="33" Stretch="Uniform"/><StackPanel Margin="13,0,0,0"><TextBlock Text="Batch Processing" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Work with multiple images" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconBolt}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="33" Height="33" Stretch="Uniform"/><StackPanel Margin="13,0,0,0"><TextBlock Text="Fast Export" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Multiple formats &amp; quality options" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel></StackPanel><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,38,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconKeyboard}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Width="27" Height="27" Stretch="Uniform"/><StackPanel Margin="12,0,0,0"><TextBlock Text="Keyboard Shortcuts" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Work faster with shortcuts" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Path Data="{StaticResource IconChevron}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Border></StackPanel>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding QueueIsEmpty}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="EDIT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedImageText" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,14,0,18"/><Border Height="1" Background="{StaticResource BorderBrush}"/><TextBlock Text="Crop" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/><Button x:Name="CropButton" Style="{StaticResource InspectorActionButton}" Click="CropSelected_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCrop}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Crop Image" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="Rotate &amp; Flip" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/><Button x:Name="RotateButton" Style="{StaticResource InspectorActionButton}" Click="RotateSelected_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRotate}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Rotate / Flip" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="Clipboard" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6"/><Button x:Name="CopyButton" Style="{StaticResource InspectorActionButton}" Click="CopySelected_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPaste}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel></Button><Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18"/><Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSelected_Click">Export Image</Button></StackPanel>
            </Grid></Border>
        </Grid>
    </DockPanel>
</Window>





