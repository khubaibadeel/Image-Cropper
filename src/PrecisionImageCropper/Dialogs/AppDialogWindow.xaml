<Window x:Class="PrecisionImageCropper.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precision Image Cropper" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False">
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Border x:Name="IconBadge" Width="38" Height="38" Background="#FFF1F1" CornerRadius="19"><Path x:Name="DialogIcon" Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock x:Name="BodyText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12"/></StackPanel></StackPanel>
            <TextBlock x:Name="SecondaryText" Grid.Row="1" Margin="51,13,0,22" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Click="Cancel_Click">Cancel</Button><Button x:Name="ConfirmButton" Style="{StaticResource DangerDialogButton}" Margin="8,0,0,0" Click="Confirm_Click">Remove</Button></StackPanel>
        </Grid>
    </Border>
</Window>

